{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/cleanup",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/cron/ping-supabase",
      "schedule": "0 0 */3 * *"
    }
  ]
}
